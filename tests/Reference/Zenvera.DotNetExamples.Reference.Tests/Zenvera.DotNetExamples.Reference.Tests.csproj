      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Reference\Zenvera.DotNetExamples.Reference.AppHost\Zenvera.DotNetExamples.Reference.AppHost.csproj" />
