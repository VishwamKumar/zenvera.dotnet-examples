    <RootNamespace>Zenvera.DotNetExamples.Reference.Tests</RootNamespace>
    <AssemblyName>Zenvera.DotNetExamples.Reference.Tests</AssemblyName>
    <Authors>Vishwa Kumar</Authors>
    <Company>Vishwam</Company>
    <Product>Zenvera .NET Examples</Product>
